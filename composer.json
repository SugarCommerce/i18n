{
  "name": "sugarcommerce/i18n",
  "description": "Translation for plain PHP: English source strings as keys, CLDR plural categories, named placeholders, and Accept-Language negotiation. Catalogues are PHP arrays, so they are opcached and need no parser. Zero dependencies.",
  "version": "1.4.0",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/i18n",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["i18n", "l10n", "translation", "gettext", "plural", "locale"],
  "require": { "php": ">=8.5" },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\I18n\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\I18n\\Tests\\": "tests/" } },
  "bin": [ "bin/i18n-strings" ],
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/i18n/issues", "source": "https://github.com/sugarcommerce/i18n" }
}
